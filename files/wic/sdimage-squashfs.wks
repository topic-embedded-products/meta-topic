# SD card image with a bootable LZ4 compressed squashfs partition and only boot files in first part
part --source bootimg-partition --fstype=vfat --label boot --align 256 --fixed-size=3840k
part --source rootfs --align 1024 --active --fstype=squashfs --mkfs-extraopts "-comp lz4 -Xhc" --extra-space=0k
