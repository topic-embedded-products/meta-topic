#include "tepzu.dts"

/* Run QSPI at 40MHz. Some bug in u-boot corrupts the data at higher speeds */
&qspi {
	flash@0 {
		spi-max-frequency = <40000000>;
	};
};

/* USB hub causes DWC3 to fail to probe in u-boot */
/delete-node/ &hub_3_0;
/delete-node/ &hub_2_0;
/* Since the hub won't work, might as well turn off the controller completely */
&usb1 {
	status = "disabled";
};
&dwc3_1 {
	status = "disabled";
};
